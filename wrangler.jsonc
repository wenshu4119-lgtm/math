{
  // Cloudflare Workers / Pages 自动部署配置
  // 项目名必须与控制台现有项目一致，否则会新建一个项目、丢掉 mrxu.uk 的域名绑定。
  "name": "muddy-wildflower-44b9",
  "compatibility_date": "2024-09-23",
  "main": "paper-worker.mjs",
  "workers_dev": true,
  "routes": [
    { "pattern": "mrxu.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mingshi-planning-db",
      "database_id": "4efffa98-afe9-43bd-b6ba-96613f57a81b"
    }
  ],
  "vars": { "PAPER_AI_ENABLED": "true" },
  "ratelimits": [{
    "name": "PAPER_RATE_LIMITER",
    "namespace_id": "71030091",
    "simple": { "limit": 3, "period": 60 }
  }]
}
