{
  "name": "junior-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ocr": "node scripts/dev.mjs --ocr",
    "ocr:setup": "node scripts/setup-ocr.mjs",
    "ocr:evaluate": "node scripts/experiments/ocr-local-evaluation.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dev:pages": "wrangler pages dev public --ip 127.0.0.1 --port 8788",
    "db:local": "wrangler d1 migrations apply DB --local",
    "probe:deeptutor": "node scripts/experiments/deeptutor-probe.mjs"
  },
  "devDependencies": {
    "wrangler": "4.160.1"
  }
}
